# ============================================================
# SecureGuard PC Software — Environment Configuration
# Copy this file to .env and fill in your values
# ============================================================

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key

# Firebase — service account JSON file (place in same folder)
FIREBASE_SERVICE_ACCOUNT=firebase_service_account.json

# User Authentication (Supabase Auth credentials)
USER_EMAIL=your-email@example.com
USER_PASSWORD=your-password

# Application Settings
VAULT_DIR=
PC_NAME=MyPC
SOFTWARE_VERSION=2.0.0
